# Camera
CONFIG_LDO_WL2866D=y
CONFIG_SPECTRA_CAMERA_UPGRADE=y

# Compass
CONFIG_AKM09970=y

# Device
CONFIG_MACH_XIAOMI_SWEET=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FS_TEE=y

# Haptics
CONFIG_INPUT_AW8624_HAPTIC=y
# CONFIG_LEDS_QPNP_HAPTICS is not set
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set

# IR
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=y

# MMC
CONFIG_MMC=y
CONFIG_MMC_PERF_PROFILING=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_BLOCK_DEFERRED_RESUME=y
CONFIG_MMC_TEST=m
CONFIG_MMC_PARANOID_SD_INIT=y
CONFIG_MMC_CLKGATE=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_MMC_CQ_HCI=y
CONFIG_MMC_CQ_HCI_CRYPTO=y
CONFIG_MMC_CQ_HCI_CRYPTO_QTI=y

# NFC
CONFIG_NFC_NQ_PN80T=y
# CONFIG_NFC_NQ is not set

# Power
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_CHARGER_LN8000=y
CONFIG_K6_CHARGE=y
CONFIG_ONEWIRE_GPIO=y
# CONFIG_SMB1355_SLAVE_CHARGER is not set
# CONFIG_SMB1390_CHARGE_PUMP_PSY is not set

# Ramoops
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"

# Step motor
CONFIG_TI_DRV8846=y

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_GTX9896_I2C=y
CONFIG_TOUCHSCREEN_FTS_K6=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_NEW_TOUCH_GAMEMODE=y
CONFIG_TOUCHSCREEN_TDDI_DBCLK=y

# Ultrasound proxmity
CONFIG_US_PROXIMITY=y

#
# Sailfish OS / hybris requirements.
# Verified against the dependency-resolved .config (not the defconfig):
#   perl hybris/mer-kernel-check/mer_verify_kernel_config <resolved .config>
# Each line below was a mandatory ERROR from that tool. 8 errors -> 0.
#

# Inter Process Communication - Sailfish will not run without it
CONFIG_SYSVIPC=y

# Virtual consoles - Android's defconfig disables these
CONFIG_VT=y

# systemd needs both; DEVTMPFS_MOUNT is also required by the hybris-boot
# init-script to populate /dev before switch_root
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# systemd uses name_to_handle_at()/open_by_handle_at()
CONFIG_FHANDLE=y

# UTF-8 filenames
CONFIG_NLS_UTF8=y

# Android routes usermode helper calls through a static helper; Sailfish does
# not, and leaving this enabled breaks that path.
# CONFIG_STATIC_USERMODEHELPER is not set

# mer-kernel-check requires this unset
# CONFIG_DUMMY is not set

# hybris-boot's usb_setup_configfs creates rndis.usb0 (generic f_rndis) and
# rndis_bam.rndis (QTI bam2bam). This kernel had neither: only F_GSI, so the
# only RNDIS function available was gsi.rndis. Both mkdir calls failed, no
# rndis0 appeared, and hybris-boot took its "could not setup USB" path, which
# sleeps 60s and reboots. Confirmed on device 2026-09-08.
# mer-kernel-check does NOT check any USB gadget option, so this passed its
# 0-error run while still being unbootable.
CONFIG_USB_CONFIGFS_RNDIS=y

# hybris-boot's init runs its OWN kernel config check, separate from
# mer-kernel-check, and writes /diagnosis.log if anything fails. A non-empty
# diagnosis.log makes it refuse to boot the rootfs. On device it reported
# exactly one failure: CONFIG_AUTOFS4_FS. mer-kernel-check does not test this
# option at all, so it cannot be caught before booting. Confirmed 2026-09-08.
CONFIG_AUTOFS4_FS=y

# Sailfish sandboxes every app with sailjail, which is a wrapper around firejail.
# firejail clone()s with CLONE_NEWUSER|CLONE_NEWPID (plus the namespaces this
# kernel already has), so without these two the call fails outright:
#     firejail version 0.9.79
#     Error: ../../src/firejail/main.c:3035: main: clone: Invalid argument
# Every sandboxed booster (booster-browser@sailfish-browser,
# booster-browser@jolla-email, booster-silica-media@jolla-camera...) then never
# becomes usable, and launching those apps fails with
#     invoker: Launch failed, application specific booster is not available
# Unsandboxed apps such as Settings keep working, which makes it look like only
# "some" apps are broken. Android turns both options off for security; Sailfish
# needs them. mer-kernel-check does not test either one, so this is a third case
# of a clean checker run on a kernel that still cannot run the UI properly.
# Confirmed on device 2026-09-09.
CONFIG_USER_NS=y
CONFIG_PID_NS=y

# Bluetooth for Sailfish OS.
#
# BT_HCIVHCI is the one that matters: bluebinder is the standard hybris bridge
# from BlueZ to the Android Bluetooth HAL, and it works by creating a virtual
# HCI adapter on /dev/vhci. Without it bluebinder connects to the HAL fine and
# then dies on "g_io_channel_shutdown: assertion 'channel != NULL' failed",
# /sys/class/bluetooth stays empty and there is no adapter at all.
#
# RFCOMM, BNEP and HIDP are what mer-kernel-check asks for and what the profiles
# need - serial, network/tethering and human interface devices respectively.
CONFIG_BT_HCIVHCI=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# Waydroid - Android apps in an LXC container, not a VM.
#
# CAREFUL WITH COMMENTS IN THIS FILE. merge_config.sh parses every line with
#   s/^\(# \)\{0,1\}\(CONFIG_[a-zA-Z0-9_]*\)[= ].*/\2/p
# so a comment that begins "# CONFIG_SOMETHING " is read as a directive, not as
# prose, and the rest of the line becomes its value. Writing
#   "# CONFIG_ASHMEM ... is already set"
# here silently turned ashmem OFF, /dev/ashmem disappeared, the composer could
# not allocate its fast message queue ("failed to prepare a new message queue")
# and the device booted to a black screen. Never start a comment line with
# "# CONFIG_<name>" followed by a space or an equals sign - name options
# mid-sentence instead, as below.
#
# Waydroid runs the Android userspace in a container sharing this kernel, with
# its own binder devices (puddlejumper/hwpuddlejumper/vndpuddlejumper) created
# dynamically in binderfs, so it does not fight the vendor HALs that
# droid-hal-init already runs for Sailfish itself. Upstream requires only
# "binder and either ashmem or memfd", and binderfs plus ashmem are already
# enabled above; the options below are the ones that were missing.
#
# The devices cgroup is what LXC uses to decide which device nodes the
# container may touch.
CONFIG_CGROUP_DEVICE=y
#
# Android's netd tags and prioritises traffic per UID, which needs the network
# classid and priority cgroups.
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
#
# The container gets a bridge and its own subnet with dnsmasq handing out
# leases. Without the CHECKSUM target the DHCP replies reach the container with
# a bad UDP checksum and are dropped, so the container never gets an address.
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# Deliberately not enabled, named mid-sentence so merge_config leaves them be:
#
# The sw_sync option - Waydroid bind-mounts /dev/sw_sync for the hardware
# composer, but make_entry() in its lxc.py defaults to "optional", so a missing
# node is skipped rather than failing the container. The symbol depends on
# debugfs, which this defconfig turns off, and enabling debugfs across the whole
# device to satisfy an optional mount is not a good trade. Revisit if the
# composer misbehaves inside the container.
#
# The squashfs option - Waydroid mounts system.img and vendor.img as ext4 and
# layers overlayfs on top (helpers/images.py); it never uses squashfs.

# EROFS, needed to mount an Android 16 system image.
#
# Android 16 builds system.img as EROFS by default, and Waydroid's own board
# config does the same. Without this the image cannot be mounted at all:
#     mount: unknown filesystem type 'erofs'
# The symbol exists in this tree - Qualcomm backported fs/erofs to 4.14 - it
# was simply never enabled. ZIP is the compressed variant, which is what
# Android actually produces.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
